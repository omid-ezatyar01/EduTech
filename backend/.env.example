# Core runtime (required)
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/edutech
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
TRUST_PROXY=false

# Public application origins
CLIENT_URL=http://localhost:5173
STUDENT_CLIENT_URL=http://localhost:5173
STUDENT_FRONTEND_URL=http://localhost:5173
TEACHER_CLIENT_URL=http://localhost:5174
TEACHER_FRONTEND_URL=http://localhost:5174
COURSE_PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_SITE_ORIGIN=http://localhost:5173
CERTIFICATE_VERIFY_ORIGIN=http://localhost:5176
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Request handling and storage
UPLOADS_DIR=
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
API_AUTH_RATE_LIMIT_MAX=3000
JSON_BODY_LIMIT=1mb
URL_ENCODED_LIMIT=1mb
URL_ENCODED_PARAMETER_LIMIT=100

# Course/session behavior
APP_NAME=EduTech
APP_TIMEZONE=Asia/Kabul
MEET_LINK_VISIBLE_BEFORE_MINUTES=0
MEET_LINK_DISABLE_AFTER_START_MINUTES=10

# HesabPay sandbox (leave credentials empty to disable). A public HTTPS tunnel
# is still required if you want the sandbox to deliver webhook callbacks.
HESABPAY_API_KEY=
HESABPAY_BASE_URL=https://api-sandbox.hesab.com
HESABPAY_WEBHOOK_CLAIM_LEASE_MS=60000
HESABPAY_ALLOW_REDIRECT_CONFIRM=false
HESABPAY_DEV_FALLBACK_REDIRECT=false
HESABPAY_USD_TO_AFN_RATE=70
HESABPAY_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
HESABPAY_EXCHANGE_RATE_TIMEOUT_MS=10000
HESABPAY_EXCHANGE_RATE_CACHE_TTL_MS=300000
HESABPAY_EXCHANGE_RATE_EMERGENCY_FALLBACK_RATE=70

# Exchange-rate providers
EXCHANGE_RATE_PROVIDER=currencyfreaks
CURRENCYFREAKS_API_KEY=
CURRENCYFREAKS_BASE_URL=https://api.currencyfreaks.com/v2.0
CURRENCYFREAKS_TIMEOUT_MS=10000
CURRENCYFREAKS_CACHE_TTL_MS=300000
IRAN_MARKET_RATE_PROVIDER=currencyapi
IRAN_MARKET_CACHE_TTL_MS=86400000
CURRENCYAPI_API_KEY=
CURRENCYAPI_BASE_URL=https://api.currencyapi.com/v3
NAVASAN_API_KEY=
NAVASAN_BASE_URL=https://api.navasan.tech
NAVASAN_USD_FIELD=usd_sell.value
NAVASAN_RATE_UNIT=toman
IRAN_MARKET_MIN_USD_TO_TOMAN_RATE=50000
CURRENCY_CONVERSION_DEBUG=false

# NOWPayments (set API key, IPN secret, and public IPN URL together)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAYMENTS_IPN_URL=
NOWPAYMENTS_PAY_CURRENCY=usdtbsc
NOWPAYMENTS_TIMEOUT_MS=30000

# Direct USDT on BSC (set RPC, recipient, and token contract together)
BSC_RPC_URL=
BSCSCAN_API_KEY=
BSCSCAN_API_BASE_URL=https://api.etherscan.io/v2/api
BSCSCAN_TIMEOUT_MS=15000
BSC_RECIPIENT_ADDRESS=
BSC_USDT_CONTRACT_ADDRESS=
BSC_PAYMENT_EXPIRY_MINUTES=60
BSC_CONFIRMATIONS_REQUIRED=1
BSC_CHAIN_ID=56
BSC_EXPLORER_BASE_URL=https://bscscan.com

# Email (configure either SMTP, Resend, or both)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_SIGNING_SECRET=

# Google login and Calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_STUDENT_REDIRECT_URI=
GOOGLE_TEACHER_REDIRECT_URI=
GOOGLE_ADMIN_REDIRECT_URI=
GOOGLE_STUDENT_CALENDAR_REDIRECT_URI=
GOOGLE_OAUTH_RESULT_REDIRECTS=
GOOGLE_OAUTH_RESULT_REDIRECT=
GOOGLE_OAUTH_RESULT_REDIRECT_BASE=
GOOGLE_STUDENT_OAUTH_RESULT_REDIRECT=
GOOGLE_TEACHER_OAUTH_RESULT_REDIRECT=
GOOGLE_ADMIN_OAUTH_RESULT_REDIRECT=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Web push
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Telegram announcements/support
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL_USERNAME=
TELEGRAM_SUPPORT_CHAT_ID=

# Local AI assistant
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b

# Social integrations
META_GRAPH_VERSION=v25.0
